# Database
POSTGRES_USER=example_user
POSTGRES_PASSWORD=example_password
POSTGRES_DB=example_db

# JWT
JWT_SECRET=example_jwt_secret

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=example@example.com
SMTP_PASS=example_password
SMTP_FROM=Example <example@example.com>

# Frontend
FRONTEND_URL=http://localhost:5173

# Google
GOOGLE_CLIENT_ID=example_client_id
GOOGLE_CLIENT_SECRET=example_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
GOOGLE_API_KEY=example_api_key
TAVILY_API_KEY=example_api_key

# Session
SESSION_SECRET=example_session_secret